# ── Supabase ──────────────────────────────────────────────────
SUPABASE_PROJECT_ID="your-supabase-project-id"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxx"
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Vite client-side duplicates (VITE_ prefix exposes them to the browser)
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxx"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# ── Neon PostgreSQL (server-side only) ────────────────────────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Resend Email (server-side only) ──────────────────────────
# Get a free API key at https://resend.com
# Leave empty to enable dry-run mode (emails logged but not sent)
RESEND_API_KEY=""

# ── Optional ─────────────────────────────────────────────────
# APP_URL is used in email links; defaults to https://societydesk.app
APP_URL="http://localhost:3000"
