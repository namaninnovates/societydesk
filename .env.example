# ==============================================================================
# SocietyDesk — Environment Variables Configuration
# ==============================================================================

# [REQUIRED] Neon Serverless PostgreSQL Connection String (with connection pooler)
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require"

# [RECOMMENDED] Secret key for signing Jose JWT authentication cookies/tokens
JWT_SECRET="your_production_jwt_secret_key_minimum_32_characters_long"

# [OPTIONAL] Resend API Key for dispatching email updates (dry-run mode if omitted)
RESEND_API_KEY="re_1234567890abcdef"

# [OPTIONAL] Canonical App URL for deep-links in notification emails
APP_URL="https://your-app.vercel.app"
VITE_APP_URL="https://your-app.vercel.app"
