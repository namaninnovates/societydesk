# ── Neon PostgreSQL (Required) ──────────────────────────────────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── JWT Authentication Secret (Required) ───────────────────────
AUTH_SECRET="your-32-character-random-secret-key-here"

# ── Resend Email (Optional) ────────────────────────────────────
# Get an API key at https://resend.com
# Leave empty to enable dry-run mode (emails logged to console)
RESEND_API_KEY=""

# ── App URL (Optional) ─────────────────────────────────────────
APP_URL="http://localhost:3000"
